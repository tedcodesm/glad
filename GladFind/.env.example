# ── Server ──────────────────────────────────────────────────────────────
PORT=3000

# DATA_DRIVER selects the data layer:
#   memory  — in-memory store, no database required (default, demo mode)
#   mongo   — MongoDB via Mongoose (production)
DATA_DRIVER=memory

# Only used when DATA_DRIVER=mongo.
# Local:  mongodb://127.0.0.1:27017/glandfind
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/glandfind
MONGODB_URI=mongodb://127.0.0.1:27017/glandfind

# HS256 signing key. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_production

NODE_ENV=development

# Comma-separated list of allowed browser origins, or * for any.
ALLOWED_ORIGINS=http://localhost:5173

# ── Client (Vite) ──────────────────────────────────────────────────────
# Leave unset in development — Vite proxies /api to the server.
# Set in production to the deployed API origin, e.g. https://api.glandfind.co.ke
VITE_API_URL=